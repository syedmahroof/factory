APP_NAME="Factory ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

# MongoDB. Not the default connection: MySQL stays the system of record.
# A model opts in with  protected $connection = 'mongodb';
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=investorportal

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER       = smtp
MAIL_HOST         = smtp.mailtrap.io
MAIL_PORT         = 2525
MAIL_USERNAME     =
MAIL_PASSWORD     =
MAIL_ENCRYPTION   = tls
MAIL_FROM_ADDRESS = "rahees@iocod.com"
MAIL_FROM_NAME    = "${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


IP_URL = "http://137.184.55.106/invportal/mmp/"
PHP_AUTH_USER = "mmp"
PHP_AUTH_PW = "mmp"


# --- Actum Processing (ACH gateway) ---------------------------------------
# Transaction credentials, issued by Actum.
ACTUM_ENDPOINT       = "https://join.actumprocessing.com/cgi-bin/dbs/man_trans.cgi"
ACTUM_PARENT_ID      =
ACTUM_SUB_ID         =

# Portal credentials for action_code calls (refund/revoke/status/balance/...).
# Rotated at https://reports.actumprocessing.com.
ACTUM_USERNAME       =
ACTUM_PASSWORD       =
ACTUM_SYSPASS        =

ACTUM_CURRENCY       = "US"
# Dedicated log file: storage/logs/actum.log (visible in the Laravel Log viewer).
ACTUM_LOG_CHANNEL    = "actum"
ACTUM_TIMEOUT        = 30
ACTUM_RETRIES        = 2
ACTUM_POSTBACK       = true
# Full URL Actum echoes response variables to (optional).
ACTUM_RESPONSE_LOCATION =

# Webhook guard. Actum defines no signing, so these are ours — confirm with
# Actum support which they can honour before relying on either.
ACTUM_WEBHOOK_ENABLED = true
ACTUM_WEBHOOK_SECRET  =
ACTUM_WEBHOOK_IPS     =
