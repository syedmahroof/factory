{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1",
        "brian2694/laravel-toastr": "^5.61",
        "dedoc/scramble": "^0.13.41",
        "guzzlehttp/guzzle": "^7.9",
        "laravel/framework": "^12.66",
        "laravel/horizon": "^5.48",
        "laravel/sanctum": "^4.3",
        "laravel/tinker": "^2.10",
        "laravel/ui": "^4.6",
        "maatwebsite/excel": "^3.1.69",
        "mongodb/laravel-mongodb": "^5.9",
        "nekhbet/laravel-collective-html": "^1.0",
        "opcodesio/log-viewer": "^3.24",
        "owen-it/laravel-auditing": "^14.0",
        "predis/predis": "^2.4",
        "pusher/pusher-php-server": "^7.2",
        "spatie/laravel-backup": "^10.3"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/dusk": "^8.3",
        "laravel/envoy": "^2.10",
        "laravel/pint": "^1.18",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.8",
        "pestphp/pest-plugin-laravel": "^3.2",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Integrations\\Crm\\": "Integrations/crm/src/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": []
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan horizon:publish --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.4"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}